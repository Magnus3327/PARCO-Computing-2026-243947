#!/bin/bash
# ------------------------------------------
# PBS - Distributed SpMV 
# ------------------------------------------

#PBS -N SpMV_MPI_Map
#PBS -o distributedMap.out
#PBS -e distributedMap.err
#PBS -q short_cpuQ
#PBS -l walltime=06:00:00
#PBS -l select=4:ncpus=64:mpiprocs=64:mem=4gb

# ------------------------------------------
# Load Required Modules
# ------------------------------------------
module load gcc91
module load mpich-3.2.1--gcc-9.1.0
module load python-3.10.14_gcc91
g++() { g++-9.1.0 "$@"; }
cd "$PBS_O_WORKDIR"

# ------------------------------------------
# Prepare directories
# ------------------------------------------
MATRIX_DIR="./matrices"
mkdir -p "$MATRIX_DIR"

OUT_DIR="./results"
mkdir -p "$OUT_DIR"
OUTPUT_FILE="$OUT_DIR/distributedMapSPMV.json"

SCRIPT_DIR="./scripts"

# ------------------------------------------
# Download Matrices
# ------------------------------------------
declare -A MATRICES
MATRICES["cit-Patents"]="SNAP"
MATRICES["soc-LiveJournal1"]="SNAP"
MATRICES["thermal2"]="Schmid"
MATRICES["Flan_1565"]="Janna"

for MAT in "${!MATRICES[@]}"; do
    GROUP=${MATRICES[$MAT]}
    if [ ! -f "$MATRIX_DIR/$MAT.mtx" ]; then
        echo "Downloading $MAT..."
        # Download from the official SuiteSparse mirror
        wget -q "https://suitesparse-collection-website.herokuapp.com/MM/$GROUP/$MAT.tar.gz" -P "$MATRIX_DIR"

        # Extraction (tar -xzf handles both decompression and extraction)
        tar -xzf "$MATRIX_DIR/$MAT.tar.gz" -C "$MATRIX_DIR"
        
        # Move .mtx file to MATRIX_DIR and clean up temporary files
        mv "$MATRIX_DIR/$MAT/$MAT.mtx" "$MATRIX_DIR/"
        rm -rf "$MATRIX_DIR/$MAT" "$MATRIX_DIR/$MAT.tar.gz"
        
        echo "$MAT.mtx downloaded and ready."
    else
        echo "$MAT.mtx is already present, skipping download."
    fi
done

# ------------------------------------------
# Compile
# ------------------------------------------
make map
EXEC="./bin/map"

if [ ! -x "$EXEC" ]; then
    echo "Error: executable $EXEC not found or not executable."
    exit 1
fi

# ------------------------------------------
# Parameters
# ------------------------------------------
ALL_RANKS=(1 4 16 64 128 256)

# Weak-scaling configurations (fixed density 0.01)
# Goal: ~1,000,000 NNZ per single rank
declare -A VIRTUAL_MATRICES=()

# P=1: Base case (N=10,000) -> 1M total NNZ
VIRTUAL_MATRICES["-VM=10000;10000;0.01"]=1

# P=4: N=20,000 -> 4M total NNZ
VIRTUAL_MATRICES["-VM=20000;20000;0.01"]=4

# P=16: N=40,000 -> 16M total NNZ
VIRTUAL_MATRICES["-VM=40000;40000;0.01"]=16

# P=64: N=80,000 -> 64M total NNZ
VIRTUAL_MATRICES["-VM=80000;80000;0.01"]=64

# P=128: N ~113,137 -> 128M total NNZ
VIRTUAL_MATRICES["-VM=113137;113137;0.01"]=128

# P=256: N=160,000 -> 256M total NNZ
VIRTUAL_MATRICES["-VM=160000;160000;0.01"]=256
ITER=10

# ------------------------------------------
# Hardware info
# ------------------------------------------
DATE_NOW=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

# Start JSON
echo "{" > "$OUTPUT_FILE"
echo "  \"date\": \"$DATE_NOW\"," >> "$OUTPUT_FILE"
echo "  \"nodes\": [" >> "$OUTPUT_FILE"

FIRST_NODE=true
for NODE in $(sort -u $PBS_NODEFILE); do
    if [ "$FIRST_NODE" = true ]; then
        FIRST_NODE=false
    else
        echo "," >> "$OUTPUT_FILE"
    fi

    ARCH=$(ssh $NODE lscpu | grep 'Architecture:' | awk '{print $2}')
    CPU_MODEL=$(ssh $NODE lscpu | grep 'Model name:' | sed 's/Model name:[ \t]*//')
    CPU_MHZ=$(ssh $NODE lscpu | grep 'CPU MHz:' | awk '{print $3}' | cut -d. -f1)
    SOCKETS=$(ssh $NODE lscpu | grep 'Socket(s):' | awk '{print $2}')
    CORES_PER_SOCKET=$(ssh $NODE lscpu | grep 'Core(s) per socket:' | awk '{print $4}')
    THREADS_PER_CORE=$(ssh $NODE lscpu | grep 'Thread(s) per core:' | awk '{print $4}')
    TOTAL_CORES=$(ssh $NODE lscpu | grep '^CPU(s):' | awk '{print $2}')
    L1D_CACHE=$(ssh $NODE lscpu | grep 'L1d cache:' | awk '{print $3}')
    L1I_CACHE=$(ssh $NODE lscpu | grep 'L1i cache:' | awk '{print $3}')
    L2_CACHE=$(ssh $NODE lscpu | grep 'L2 cache:' | awk '{print $3}')
    L3_CACHE=$(ssh $NODE lscpu | grep 'L3 cache:' | awk '{print $3}')
    BYTE_ORDER=$(ssh $NODE lscpu | grep 'Byte Order:' | awk '{print $3, $4}')

    cat <<EOF >> "$OUTPUT_FILE"
    {
        "architecture": "$ARCH",
        "cpu_model": "$CPU_MODEL",
        "cpu_mhz": $CPU_MHZ,
        "sockets": $SOCKETS,
        "cores_per_socket": $CORES_PER_SOCKET,
        "threads_per_core": $THREADS_PER_CORE,
        "total_cores": $TOTAL_CORES,
        "l1d_cache": "$L1D_CACHE",
        "l1i_cache": "$L1I_CACHE",
        "l2_cache": "$L2_CACHE",
        "l3_cache": "$L3_CACHE",
        "byte_order": "$BYTE_ORDER"
    }
EOF
done

echo "  ]," >> "$OUTPUT_FILE"
echo "  \"results\": [" >> "$OUTPUT_FILE"

# ------------------------------------------
# Run all ranks and matrices
# ------------------------------------------
FIRST_ENTRY_GLOBAL=true

for RANKS in "${ALL_RANKS[@]}"; do
    # Real matrices
    for matrix in "$MATRIX_DIR"/*.mtx; do
        [ -e "$matrix" ] || continue

        if [ "$FIRST_ENTRY_GLOBAL" = true ]; then
            FIRST_ENTRY_GLOBAL=false
        else
            echo "," >> "$OUTPUT_FILE"
        fi

        echo "   -> Processing $(basename "$matrix") with $RANKS ranks..."
        JSON_OUTPUT=$(mpirun -np $RANKS $EXEC "-M=$matrix" "-I=$ITER")
        echo "$JSON_OUTPUT" >> "$OUTPUT_FILE"
    done
done

# Virtual matrices
for vm_param in "${!VIRTUAL_MATRICES[@]}"; do
    RANK="${VIRTUAL_MATRICES[$vm_param]}"

    if [ "$FIRST_ENTRY_GLOBAL" = true ]; then
        FIRST_ENTRY_GLOBAL=false
    else
        echo "," >> "$OUTPUT_FILE"
    fi

    echo "   -> Processing virtual matrix $vm_param with $RANK ranks..."
    JSON_OUTPUT=$(mpirun -np "$RANK" "$EXEC" "$vm_param" "-I=$ITER")
    echo "$JSON_OUTPUT" >> "$OUTPUT_FILE"
done


# Close JSON
echo "  ]" >> "$OUTPUT_FILE"
echo "}" >> "$OUTPUT_FILE"

echo "All runs completed. JSON saved in $OUTPUT_FILE"

# ------------------------------------------
# Plotting
# ------------------------------------------
set -euo pipefail

PLOTS_DIR="$OUT_DIR/plots"
mkdir -p "$PLOTS_DIR"

PLOT_DIR="$PLOTS_DIR/map"
mkdir -p "$PLOT_DIR"

python3 -m venv plot_env2
source plot_env2/bin/activate

pip install --upgrade pip >/dev/null
pip install matplotlib numpy pandas

# Scaling plots
python "$SCRIPT_DIR/plots/strongScaling.py"   "$OUTPUT_FILE" "$PLOT_DIR"
python "$SCRIPT_DIR/plots/weakScaling.py"     "$OUTPUT_FILE" "$PLOT_DIR"
python "$SCRIPT_DIR/plots/strongScalingSE.py" "$OUTPUT_FILE" "$PLOT_DIR"
python "$SCRIPT_DIR/plots/weakScalingSE.py"   "$OUTPUT_FILE" "$PLOT_DIR"

# Execution time per matrix
for matrix in "$MATRIX_DIR"/*.mtx; do
    [[ -e "$matrix" ]] || continue
    python "$SCRIPT_DIR/plots/executionTime.py" "$OUTPUT_FILE" "$matrix" "$PLOT_DIR"
done

deactivate
rm -rf plot_env2